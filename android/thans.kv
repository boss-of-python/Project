#:kivy 2.0
#:import Window kivy.core.window.Window
# THANS (Android) — dark, minimal, one accent.  Mirrors the desktop design:
# header chips · transcript · suggestion pills · composer · hero · boot splash.
#
# Every animated property is driven from Python (thans_android/app.py) so the
# motion language stays in one place and can be switched off in one switch.

<RoundedButton>:
    bold: False
    halign: "center"
    valign: "middle"
    markup: False
    text_size: self.size

<CircleButton>:

<MicButton>:

<Chip>:
    font_size: sp(11)
    halign: "center"
    valign: "middle"
    text_size: self.size
    padding: dp(16), 0
    size_hint: None, None
    height: dp(28)
    width: self.texture_size[0] + dp(30)
    canvas.after:
        Color:
            rgba: 0, 0, 0, 0

<Toast>:
    font_size: sp(12)
    halign: "center"
    valign: "middle"
    text_size: self.size
    size_hint: None, None
    height: dp(38)
    width: min(Window.width - dp(24), self.texture_size[0] + dp(44))

<Bubble>:

<TypingDots>:
    size_hint: None, None
    size: dp(34), dp(14)

ThansRoot:
    # ---------------------------------------------------------------- splash
    Widget:
        id: boot
        canvas.before:
            Color:
                rgba: app.tok["BG"]
            Rectangle:
                pos: self.pos
                size: self.size
        BoxLayout:
            orientation: "vertical"
            padding: dp(28)
            spacing: dp(10)
            Widget:
            BoxLayout:
                id: boot_mark_row
                size_hint_y: None
                height: dp(52)
                Widget:
                Label:
                    id: boot_mark
                    text: app.sym["sparkle"]
                    font_size: sp(30)
                    color: app.tok["ACCENT"]
                    size_hint: None, None
                    size: dp(52), dp(52)
                Widget:
            Label:
                id: boot_word
                text: "THANS"
                bold: True
                font_size: sp(14)
                color: app.tok["FG"]
                size_hint_y: None
                height: dp(38)
            Label:
                id: boot_sub
                text: "offline voice & text file assistant"
                font_size: sp(11)
                color: app.tok["FG_DIM"]
                opacity: 0
                size_hint_y: None
                height: dp(20)
            Widget:
                size_hint_y: None
                height: dp(14)
            SweepBar:
                id: boot_bar
                size_hint: None, None
                size: dp(200), dp(5)
                pos_hint: {"center_x": 0.5}
            Label:
                id: boot_status
                text: "starting engine"
                font_size: sp(11)
                color: app.tok["FG_FAINT"]
                opacity: 0
                size_hint_y: None
                height: dp(22)
            Widget:

    # ------------------------------------------------------------- main view
    BoxLayout:
        id: main
        orientation: "vertical"
        padding: dp(10), dp(8), dp(10), dp(10)
        spacing: dp(8)
        opacity: 0

        # header — mark, title, status chips
        BoxLayout:
            size_hint_y: None
            height: dp(40)
            spacing: dp(6)
            Label:
                text: app.sym["sparkle"]
                font_size: sp(16)
                color: app.tok["ACCENT"]
                size_hint: None, None
                size: dp(24), dp(40)
            Label:
                text: "THANS"
                bold: True
                font_size: sp(17)
                color: app.tok["FG"]
                halign: "left"
                valign: "middle"
                size_hint_x: 0.34
                text_size: self.size
            Chip:
                id: chip_voice
                text: "voice"
                dot_color: app.tok["FG_FAINT"]
                on_release: app.toggle_speak()
            Chip:
                id: chip_llm
                text: "rule parser"
                dot_color: app.tok["OK"]
                on_release: app.show_capabilities()

        # status line with thinking dots + busy sweep
        BoxLayout:
            size_hint_y: None
            height: dp(22)
            spacing: dp(8)
            Label:
                id: status
                text: "ready"
                font_size: sp(11)
                color: app.tok["FG_DIM"]
                halign: "left"
                valign: "middle"
                text_size: self.size
                shorten: True
            TypingDots:
                id: dots
                size_hint_x: None
                width: dp(34)

        SweepBar:
            id: busy_bar
            size_hint_y: None
            height: dp(3)
            opacity: 0

        # transcript (newest on top)
        ScrollView:
            id: chat_scroll
            do_scroll_x: False
            bar_width: dp(2)
            bar_color: app.tok["ACCENT_HI"]
            BoxLayout:
                id: chat_box
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(8)
                padding: dp(2), dp(2), dp(2), dp(2)

        # suggestion pills (appear while typing)
        ScrollView:
            id: suggest_scroll
            size_hint_y: None
            height: 0
            opacity: 0
            do_scroll_x: True
            do_scroll_y: False
            bar_width: 0
            BoxLayout:
                id: suggest_box
                orientation: "horizontal"
                size_hint_x: None
                width: self.minimum_width
                spacing: dp(6)

        # quick actions
        BoxLayout:
            size_hint_y: None
            height: dp(34)
            spacing: dp(6)
            RoundedButton:
                text: app.sym["wand"] + "  Organize"
                subtle: True
                font_size: sp(12)
                on_release: app.run_quick("organize .")
            RoundedButton:
                text: app.sym["undo"] + "  Undo"
                subtle: True
                font_size: sp(12)
                on_release: app.run_quick("undo")
            RoundedButton:
                text: app.sym["list"] + "  Count"
                subtle: True
                font_size: sp(12)
                on_release: app.run_quick("how many files in .")
            RoundedButton:
                text: app.sym["keyboard"] + "  Help"
                subtle: True
                font_size: sp(12)
                on_release: app.run_quick("help")

        # composer
        BoxLayout:
            size_hint_y: None
            height: dp(50)
            spacing: dp(8)
            Card:
                id: input_card
                radius: dp(14)
                padding: dp(10), 0
                TextInput:
                    id: input
                    multiline: False
                    font_size: sp(15)
                    background_color: 0, 0, 0, 0
                    foreground_color: app.tok["FG"]
                    cursor_color: app.tok["ACCENT_HI"]
                    hint_text: "type a command…  e.g. create folder work"
                    hint_foreground_color: app.tok["FG_FAINT"]
                    on_text: app.on_input_text(self.text)
                    on_text_validate: app.send_input()
            MicButton:
                id: btn_mic
                size_hint: None, None
                size: dp(50), dp(50)
                opacity: 0.3 if app.mic_unavailable else 1.0
                on_release: app.toggle_mic()
            CircleButton:
                id: btn_send
                text: app.sym["send"]
                primary: True
                size_hint: None, None
                size: dp(50), dp(50)
                font_size: sp(18)
                on_release: app.send_input()

    # ------------------------------------------------------------------- hero
    Card:
        id: hero
        orientation: "vertical"
        padding: dp(20), dp(18)
        spacing: dp(8)
        opacity: 0
        size_hint: None, None
        size: min(Window.width - dp(48), dp(340)), dp(300)
        pos_hint: {"center_x": 0.5, "center_y": 0.56}
        Label:
            text: app.sym["sparkle"]
            font_size: sp(28)
            color: app.tok["ACCENT"]
            size_hint_y: None
            height: dp(34)
        Label:
            text: "THANS"
            bold: True
            font_size: sp(24)
            color: app.tok["FG"]
            size_hint_y: None
            height: dp(32)
        Label:
            text: "Your files, by voice or by thumb.\nEverything stays on this phone."
            font_size: sp(12)
            color: app.tok["FG_DIM"]
            size_hint_y: None
            height: dp(40)
        Widget:
            size_hint_y: None
            height: dp(4)
        RoundedButton:
            text: app.sym["wand"] + "  Organize this folder"
            subtle: True
            font_size: sp(12)
            size_hint_y: None
            height: dp(38)
            on_release: app.starter("organize .")
        RoundedButton:
            text: app.sym["search"] + "  Find a file"
            subtle: True
            font_size: sp(12)
            size_hint_y: None
            height: dp(38)
            on_release: app.starter("find ")
        RoundedButton:
            text: app.sym["folder"] + "  Create a folder"
            subtle: True
            font_size: sp(12)
            size_hint_y: None
            height: dp(38)
            on_release: app.starter("create folder ")
        Widget:
            size_hint_y: None
            height: dp(2)
        Label:
            text: app.working_root
            font_size: sp(10)
            color: app.tok["FG_FAINT"]
            size_hint_y: None
            height: dp(26)
            shorten: True
            text_size: self.size

    # ----------------------------------------------------------------- toasts
    BoxLayout:
        id: toasts
        orientation: "vertical"
        size_hint: None, None
        width: Window.width - dp(24)
        height: dp(200)
        pos_hint: {"center_x": 0.5, "top": 0.98}
        spacing: dp(6)
